<!-- https://jakarta.ee/xml/ns/persistence/ -->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence ${persistence.schemaLocation}"
             version="${persistence.version}">
  <persistence-unit name="test" transaction-type="RESOURCE_LOCAL">
    <description>Persistence Unit for a PostgreSQL Container</description>
    <!--        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>-->
    <provider>${persistence-unit.provider}</provider>
    <class>com.github.jinahya.postgresql.demodb.persistence.converter.IntegerListArrayAttributeConverter$OfString</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.converter.IntervalPostgresAttributeConverter$OfString</class>
    <class>com.github.jinahya.persistence.more.converter.json.JsonpStringAttributeConverter$OfJsonObject</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.converter.PointAttributeConverter$OfString</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.mapped.MappedSeat$FareConditionsConverter</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.mapped.MappedFlight$FlightStatusConverter</class>
    <class>com.github.jinahya.persistence.more.converter.time.ZoneIdStringAttributeConverter</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.AirplaneData</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.AirportData</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.Booking</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.Ticket</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.Flight</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.Route</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.RouteId</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.Seat</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.Segment</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.BoardingPass</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.Airplane</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.Airport</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.Timetable</class>
    <exclude-unlisted-classes>true</exclude-unlisted-classes>
    <shared-cache-mode>NONE</shared-cache-mode>
    <validation-mode>CALLBACK</validation-mode>
    <properties>
      <!-- a plain PostgreSQL container, which Testcontainers starts from the URL alone; the unit generates its -->
      <!-- schema, so the image needs no data; TC_DAEMON=true keeps the container for the whole test JVM -->
      <!-- https://java.testcontainers.org/modules/databases/jdbc/ -->
      <property name="jakarta.persistence.jdbc.driver" value="org.testcontainers.jdbc.ContainerDatabaseDriver"/>
      <property name="jakarta.persistence.jdbc.url" value="jdbc:tc:postgresql:18-alpine:///test?TC_DAEMON=true"/>
      <property name="jakarta.persistence.jdbc.user" value="test"/>
      <property name="jakarta.persistence.jdbc.password" value="test"/>
      <!-- /////////////////////////////////////////////////////////////////////////////////////////////// hibernate -->
      <!--      <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>-->
      <property name="hibernate.format_sql" value="true"/>
      <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
      <property name="hibernate.highlight_sql" value="true"/>
      <property name="hibernate.show_sql" value="true"/>
      <property name="hibernate.use_sql_comment" value="true"/>
    </properties>
  </persistence-unit>
  <persistence-unit name="it" transaction-type="RESOURCE_LOCAL">
    <description>Persistence Unit for a Physical Database</description>
    <!--    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>-->
    <provider>${persistence-unit.provider}</provider>
    <class>com.github.jinahya.postgresql.demodb.persistence.converter.IntegerListArrayAttributeConverter$OfString</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.converter.IntervalPostgresAttributeConverter$OfString</class>
    <class>com.github.jinahya.persistence.more.converter.json.JsonpStringAttributeConverter$OfJsonObject</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.converter.PointAttributeConverter$OfString</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.mapped.MappedSeat$FareConditionsConverter</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.mapped.MappedFlight$FlightStatusConverter</class>
    <class>com.github.jinahya.persistence.more.converter.time.ZoneIdStringAttributeConverter</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.AirplaneData</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.AirportData</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.Booking</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.Ticket</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.Flight</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.Route</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.RouteId</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.Seat</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.Segment</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.BoardingPass</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.Airplane</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.Airport</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.Timetable</class>
    <exclude-unlisted-classes>true</exclude-unlisted-classes>
    <shared-cache-mode>NONE</shared-cache-mode>
    <validation-mode>CALLBACK</validation-mode>
    <properties>
      <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
      <!-- the database from compose.yaml; see _docker-compose-up.sh -->
      <!-- the dump creates database `demo` and puts everything in schema `bookings`, which it also makes the -->
      <!-- database's search_path, so unqualified table names resolve there -->
      <!-- stringtype=unspecified: a String bound for a tstzrange, point, jsonb, integer[] or interval column is sent -->
      <!-- untyped, so that the server casts it; see README.md, "Column types the providers differ on" -->
      <!-- options=-c IntervalStyle=postgres: an interval is printed in the postgres style whatever the server's, -->
      <!-- database's or role's default; the driver's own PGInterval, which is what EclipseLink hands a converter, -->
      <!-- misreads sql_standard, and IntervalPostgresAttributeConverter reads the postgres style only -->
      <!-- options=-c bookings.lang=...: the language the views read their names in, bookings.lang(); the -->
      <!-- bookings-lang-en (default) and bookings-lang-ru profiles in pom.xml choose it -->
      <property name="jakarta.persistence.jdbc.url"
                value="jdbc:postgresql://localhost:5432/demo?stringtype=unspecified&amp;options=-c%20IntervalStyle=postgres%20-c%20bookings.lang=${bookings.lang}"/>
      <property name="jakarta.persistence.jdbc.user" value="postgres"/>
      <property name="jakarta.persistence.jdbc.password" value="password"/>
      <!-- /////////////////////////////////////////////////////////////////////////////////////////////// hibernate -->
      <!--      <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>-->
      <property name="hibernate.format_sql" value="true"/>
      <property name="hibernate.hbm2ddl.auto" value="none"/>
      <property name="hibernate.highlight_sql" value="true"/>
      <property name="hibernate.show_sql" value="true"/>
      <property name="hibernate.use_sql_comment" value="true"/>
    </properties>
  </persistence-unit>
</persistence>
