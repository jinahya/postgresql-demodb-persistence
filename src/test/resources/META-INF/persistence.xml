<!-- https://jakarta.ee/xml/ns/persistence/ -->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence ${persistence.schemaLocation}"
             version="${persistence.version}">
  <persistence-unit name="test" transaction-type="RESOURCE_LOCAL">
    <description>Persistence Unit for an In-Memory Database</description>
    <!--    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>-->
    <provider>${persistence-unit.provider}</provider>
    <class>com.github.jinahya.persistence.more.converter.jakartajson.JsonpAttributeConverter$OfString$OfJsonObject</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.mapped.PointAttributeConverter</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.mapped.MappedRouteId$ValidityConverter</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.mapped.MappedSeat$FareConditionsConverter</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.mapped.MappedFlight$FlightStatusConverter</class>
    <class>com.github.jinahya.persistence.more.converter.javatime.ZoneIdStringAttributeConverter</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.AirplaneData</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.AirportData</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.Booking</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.Ticket</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.Flight</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.Route</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.RouteId</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.Seat</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.Segment</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.BoardingPass</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.Airplane</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.Airport</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.Timetable</class>
    <exclude-unlisted-classes>true</exclude-unlisted-classes>
    <shared-cache-mode>NONE</shared-cache-mode>
    <validation-mode>CALLBACK</validation-mode>
    <properties>
      <!-- H2, in memory; the schema is generated from the -->
      <!-- mappings, empty, and dropped at the end -->
      <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
      <!-- DB_CLOSE_DELAY=-1: one database for every connection of the run, not one per connection -->
      <!-- INIT=...: H2 has no tstzrange, which MappedRouteId's validity names as its columnDefinition; a domain -->
      <!-- over VARCHAR takes the text ValidityConverter writes -->
      <property name="jakarta.persistence.jdbc.url"
                value="jdbc:h2:mem:test;DB_CLOSE_DELAY=-1;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;INIT=CREATE DOMAIN IF NOT EXISTS tstzrange AS VARCHAR(255)"/>
      <property name="jakarta.persistence.jdbc.user" value="sa"/>
      <property name="jakarta.persistence.jdbc.password" value="password"/>
      <!-- /////////////////////////////////////////////////////////////////////////////////////////////// hibernate -->
      <!--      <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>-->
      <property name="hibernate.format_sql" value="true"/>
      <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
      <property name="hibernate.highlight_sql" value="true"/>
      <property name="hibernate.show_sql" value="true"/>
      <property name="hibernate.use_sql_comment" value="true"/>
    </properties>
  </persistence-unit>
  <persistence-unit name="it" transaction-type="RESOURCE_LOCAL">
    <description>Persistence Unit for a Physical Database</description>
    <!--    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>-->
    <provider>${persistence-unit.provider}</provider>
    <class>com.github.jinahya.persistence.more.converter.jakartajson.JsonpAttributeConverter$OfString$OfJsonObject</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.mapped.PointAttributeConverter</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.mapped.MappedRouteId$ValidityConverter</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.mapped.MappedSeat$FareConditionsConverter</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.mapped.MappedFlight$FlightStatusConverter</class>
    <class>com.github.jinahya.persistence.more.converter.javatime.ZoneIdStringAttributeConverter</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.AirplaneData</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.AirportData</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.Booking</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.Ticket</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.Flight</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.Route</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.RouteId</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.Seat</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.Segment</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.BoardingPass</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.Airplane</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.Airport</class>
    <class>com.github.jinahya.postgresql.demodb.persistence.Timetable</class>
    <exclude-unlisted-classes>true</exclude-unlisted-classes>
    <shared-cache-mode>NONE</shared-cache-mode>
    <validation-mode>CALLBACK</validation-mode>
    <properties>
      <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
      <!-- the database from compose.yaml; see compose.sh -->
      <!-- the dump creates database `demo` and puts everything in schema `bookings`, which it also makes the -->
      <!-- database's search_path, so unqualified table names resolve there -->
      <!-- stringtype=unspecified: a String bound for a tstzrange, point or jsonb column is sent untyped, so that the -->
      <!-- server casts it; see README.md, "The column types" -->
      <!-- options=-c bookings.lang=...: the language the views read their names in, bookings.lang(); the -->
      <!-- bookings-lang-en (default) and bookings-lang-ru profiles in pom.xml choose it -->
      <property name="jakarta.persistence.jdbc.url"
                value="jdbc:postgresql://localhost:5432/demo?stringtype=unspecified&amp;options=-c%20bookings.lang=${bookings.lang}"/>
      <property name="jakarta.persistence.jdbc.user" value="postgres"/>
      <property name="jakarta.persistence.jdbc.password" value="Passw0rd!"/>
      <!-- /////////////////////////////////////////////////////////////////////////////////////////////// hibernate -->
      <!--      <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>-->
      <property name="hibernate.format_sql" value="true"/>
      <property name="hibernate.hbm2ddl.auto" value="none"/>
      <property name="hibernate.highlight_sql" value="true"/>
      <property name="hibernate.show_sql" value="true"/>
      <property name="hibernate.use_sql_comment" value="true"/>
    </properties>
  </persistence-unit>
</persistence>
