              <version>${metamodel.generator.version}</version>
            </path>
          </annotationProcessorPaths>
          <compilerArgs>
            <arg>-Xlint</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <id>enforce-dependency-convergence</id>
            <configuration>
              <rules>
                <dependencyConvergence />
              </rules>
            </configuration>
            <goals>
              <goal>enforce</goal>
            </goals>
          </execution>
          <execution>
            <id>enforce-require-java-version</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21.0.0,)</version>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
          <execution>
            <id>enforce-require-maven-version</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[3.6.3,)</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
          <execution>
            <!-- a -P naming a profile that does not exist is silently ignored by Maven; this turns
                 that into a build failure, so that a misspelled failsafe or bookings-lang-* profile, or one
                 removed, such as the provider profiles were, is not quietly a run without it. -->
            <id>enforce-require-profile-ids-exist</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireProfileIdsExist />
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${version.maven-surefire}</version>
        <configuration>
          <excludes>
            <!--            <exclude>**/*IT.java</exclude> &lt;!&ndash; 이게 왜 필요한지 확인 필요 &ndash;&gt;-->
          </excludes>
          <skipAfterFailureCount>1</skipAfterFailureCount>
          <!-- UTC: the driver sets the session's time zone to the JVM's, and a tstzrange reads back in it;
               see MappedRoute. @{argLine} is jacoco's agent, prepare-agent's -->
          <argLine>@{argLine} -Duser.timezone=UTC</argLine>
          <trimStackTrace>false</trimStackTrace>
        </configuration>
      </plugin>
      <!--
        The randomizers and persisters are compiled with the tests, which use them, and packaged here as a second jar,
        classified test-companion, which a consumer takes at <scope>test</scope>. A classified jar shares this pom, in
        which the libraries they need, podam and jinahya-persistence-test-utils, are test-scoped, so it brings none of
        them; the consumer declares its own. The includes are what keep the tests, persistence.xml and logback-test.xml
        out of it.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>test-companion-jar</id>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <classesDirectory>${project.build.testOutputDirectory}</classesDirectory>
              <classifier>test-companion</classifier>
              <includes>
                <include>**/*_Randomizer.class</include>
                <include>**/*_Randomizer$*.class</include>
                <include>**/*_Persister.class</include>
                <include>**/*_Persister$*.class</include>
                <!-- The randomizers draw their codes, dates and literals from this helper; it goes with them. -->
                <include>**/__Random_TestUtils.class</include>
              </includes>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <version>2.7.1</version>
        <configuration>
          <licenseName>apache_v2</licenseName>
          <!-- A .sql header opens and closes with a dash after the comment marker, the mysql style, in every module:
               the default sql style would open and close with three dashes, which MySQL does not take for a comment. -->
          <extraExtensions>
            <sql>mysql</sql>
          </extraExtensions>
          <!-- src alone: by default the plugin also walks target/generated-sources, and would put a header on every
               generated metamodel class, which the next build throws away. -->
          <roots>
            <root>src</root>
          </roots>
          <excludes>
            <exclude>**/*.json</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>default-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>default-report</id>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <reporting>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jxr-plugin</artifactId>
        <version>3.6.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <reportSets>
          <reportSet>
            <id>main</id>
            <configuration>
              <!-- The published apidocs: public API only, and every element of it documented. -->
              <show>protected</show>
              <additionalOptions combine.self="override">
                <additionalOption>-Xdoclint:${doclint}</additionalOption>
              </additionalOptions>
              <!-- In module mode javadoc reads the whole module from its source path, so the generated -->
              <!-- metamodel there would be linted with -missing on, which it cannot pass. This reportSet -->
              <!-- runs javadoc-no-fork alone, so here, unlike the plugin level, the source path can be -->
              <!-- narrowed to the hand-written sources without misdirecting test-javadoc. -->
              <disableSourcepathUsage>false</disableSourcepathUsage>
              <sourcepath>${project.build.sourceDirectory}</sourcepath>
            </configuration>
            <reports>
              <report>javadoc-no-fork</report>
            </reports>
          </reportSet>
          <reportSet>
            <id>tests</id>
            <configuration>
              <!-- Every test class is package-private, so the default `protected` finds nothing to -->
              <!-- document, and javadoc reports that as an error. -->
              <show>package</show>
              <!-- Package-private constructors and @Test methods carry no javadoc by convention, so -->
              <!-- check references and syntax rather than presence. combine.self is required: without -->
              <!-- it Maven merges the list and the plugin-level -Xdoclint:${doclint} comes along too. -->
              <additionalOptions combine.self="override">
                <additionalOption>-Xdoclint:all,-missing</additionalOption>
              </additionalOptions>
              <!-- test-javadoc links the test apidocs to the main ones, ../apidocs, whenever those exist, -->
              <!-- and no parameter turns that off. The test sources are documented in the unnamed module -->
              <!-- and the main ones in a named module, which javadoc warns of, outside doclint. So a -->
              <!-- warning does not fail this report; an error, a broken reference among them, does. -->
              <failOnWarnings>false</failOnWarnings>
            </configuration>
            <reports>
              <report>test-javadoc-no-fork</report>
            </reports>
          </reportSet>
        </reportSets>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>3.6.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <version>3.28.0</version>
        <configuration>
          <!-- Unsupported targetJdk value '21'. -->
          <skip>true</skip>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <reportSets>
          <reportSet>
            <reports>
              <report>report</report>
            </reports>
          </reportSet>
        </reportSets>
      </plugin>
    </plugins>
  </reporting>

  <profiles>
    <profile>
      <id>failsafe</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <version>${version.maven-failsafe}</version>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <includes>
                <include>**/*IT.java</include>
              </includes>
              <skipAfterFailureCount>1</skipAfterFailureCount>
              <!-- UTC, as surefire's; see there -->
              <argLine>@{argLine} -Duser.timezone=UTC</argLine>
              <trimStackTrace>false</trimStackTrace>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- The language the views (airplanes, airports, timetable) read their names in: the `it`
         unit passes it to the server as bookings.lang on the JDBC URL. The demo database's own default is
         en; the names are there in en and ru only, and any other language reads as NULL.
         Naming any profile on the command line deactivates every activeByDefault profile, so the defaults
         in <properties> are bookings-lang-en's; a run which names only the failsafe profile still reads en. -->
    <profile>
      <id>bookings-lang-en</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <bookings.lang>en</bookings.lang>
      </properties>
    </profile>
    <profile>
      <id>bookings-lang-ru</id>
      <properties>
        <bookings.lang>ru</bookings.lang>
      </properties>
    </profile>
  </profiles>
</project>
