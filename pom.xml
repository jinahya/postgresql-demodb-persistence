    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>${maven.compiler.source}</maven.compiler.target>
    <maven.compiler.release>${maven.compiler.target}</maven.compiler.release>
    <!-- Keep constructor parameter names in the class files, so that name-based row mappers (e.g., Spring's -->
    <!-- JdbcClient) can match the all-args constructors of the non-entity view classes to the columns. -->
